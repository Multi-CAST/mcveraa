        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34893" ANNOTATION_REF="a19292">
                <ANNOTATION_VALUE>ba lēn masōgi dirēk laklaka lēn lōlō ge 'anē'ē</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34894" ANNOTATION_REF="a19293">
                <ANNOTATION_VALUE>'erō m̄eter ne van ma ne kalkal rērē segēne?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34895" ANNOTATION_REF="a19294">
                <ANNOTATION_VALUE>rērē volvol sa eragam la.. laklaka nē managi dir ga da nōrēn ... nēn ... dir ga misig dirē dir ga ...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34896" ANNOTATION_REF="a19295">
                <ANNOTATION_VALUE>dan 'erē m̄ōgm̄ōglēge dir ga 'al gōr enteg dirē</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34897" ANNOTATION_REF="a19296">
                <ANNOTATION_VALUE>di e 'ēn'ēn enteg rōs</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34898" ANNOTATION_REF="a19297">
                <ANNOTATION_VALUE>XXX di ne van ma ne rērē e ruwa 'agēn ō di rōs</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34899" ANNOTATION_REF="a19298">
                <ANNOTATION_VALUE>di ga lama'i enteg wal so e Wōwut mal es kel</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34900" ANNOTATION_REF="a19299">
