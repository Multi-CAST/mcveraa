        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34931" ANNOTATION_REF="a19330">
                <ANNOTATION_VALUE>durum 'og 'i 'ekēnē</ANNOTATION_VALUE>
