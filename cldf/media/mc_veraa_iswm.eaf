        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34888" ANNOTATION_REF="a19287">
                <ANNOTATION_VALUE>dirēm saasag won 'ekēm miliglig enteg</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34889" ANNOTATION_REF="a19288">
                <ANNOTATION_VALUE>wo dirēk kalu lēn vunu 'a Lan̄tir</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34890" ANNOTATION_REF="a19289">
                <ANNOTATION_VALUE>dirēm kalu lēn vunu 'a Lan̄tir</ANNOTATION_VALUE>
