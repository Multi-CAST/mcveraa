        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34918" ANNOTATION_REF="a19317">
                <ANNOTATION_VALUE>dim kalakam gis vavarga diē</ANNOTATION_VALUE>
