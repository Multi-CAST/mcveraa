            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34886" ANNOTATION_REF="a19285">
                <ANNOTATION_VALUE>dirēm van van vavavan dirēm din̄ ēn bē gōr wa'ag</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34887" ANNOTATION_REF="a19286">
                <ANNOTATION_VALUE>dirēk sag momse 'ekēnē managi nē? mal revrev lōo mal van</ANNOTATION_VALUE>
