                <ANNOTATION_VALUE>Tagarlōlqōn̄ was sitting there, saying:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a96288" ANNOTATION_REF="a75428">
