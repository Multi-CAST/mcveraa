        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a87918" ANNOTATION_REF="a68792">
                <ANNOTATION_VALUE>'Hey, good morning, my friends.' 'Good morning.'</ANNOTATION_VALUE>
