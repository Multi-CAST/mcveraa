        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a27844" ANNOTATION_REF="a13413">
                <ANNOTATION_VALUE>ne maran kel ma</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a27845" ANNOTATION_REF="a13414">
                <ANNOTATION_VALUE>'erē qō' ... ēn qō' ... ēn 'ama' kurkur ne van siksik dire va'agēn van ma ba dir man rorow den san vovonore</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a27846" ANNOTATION_REF="a13415">
                <ANNOTATION_VALUE>'alēn .... n 'am... 'ama' dine van din̄ man vunu 'anēn ren̄e 'anē man van ... van dim kal ba'a lēn qoro liē</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a27847" ANNOTATION_REF="a13416">
