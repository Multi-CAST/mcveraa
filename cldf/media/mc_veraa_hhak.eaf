            <REF_ANNOTATION ANNOTATION_ID="a36558" ANNOTATION_REF="a27911">
                <ANNOTATION_VALUE>The two paddled</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a36559" ANNOTATION_REF="a27912">
                <ANNOTATION_VALUE>Their mother was singing the song,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a36560" ANNOTATION_REF="a27913">
                <ANNOTATION_VALUE>and the devil was removing the rocks from the door of the cave.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a36561" ANNOTATION_REF="a27914">
                <ANNOTATION_VALUE>The two paddled and paddled, they paddled towards the shore, heard:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a36676" ANNOTATION_REF="a27915">
                <ANNOTATION_VALUE>[SONG]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a36677" ANNOTATION_REF="a27916">
                <ANNOTATION_VALUE>[SONG]</ANNOTATION_VALUE>
