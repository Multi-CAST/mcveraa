        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a36538" ANNOTATION_REF="a27887">
                <ANNOTATION_VALUE>said: 'Hey, Marino, listen landwards.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a36539" ANNOTATION_REF="a27888">
                <ANNOTATION_VALUE>I hear noise, mum is singing a song.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a36540" ANNOTATION_REF="a27889">
                <ANNOTATION_VALUE>maybe ...'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
