            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a27853" ANNOTATION_REF="a13422">
                <ANNOTATION_VALUE>ne qōn̄ dine mul ba'a lēn lōlō qoro liē ne maran dine kalu ne van ne lele gor e gengen lēn 'ēqē</ANNOTATION_VALUE>
            </REF_ANNOTATION>
