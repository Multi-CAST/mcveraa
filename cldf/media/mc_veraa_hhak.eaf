        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a27850" ANNOTATION_REF="a13419">
                <ANNOTATION_VALUE>a qē dine ... dine visis</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a27851" ANNOTATION_REF="a13420">
                <ANNOTATION_VALUE>dim visis ēn ... n m̄ērm̄ēre ne vōruōn varaba</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a27852" ANNOTATION_REF="a13421">
