        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a36678" ANNOTATION_REF="a27917">
                <ANNOTATION_VALUE>[SONG]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a36562" ANNOTATION_REF="a27918">
                <ANNOTATION_VALUE>The two were paddling, paddled ashore,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a36563" ANNOTATION_REF="a27919">
                <ANNOTATION_VALUE>dragged the canoe ashore,</ANNOTATION_VALUE>
