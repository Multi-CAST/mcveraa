        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a11198" ANNOTATION_REF="a8318">
                <ANNOTATION_VALUE>Then their uncle got up and said to them:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a11199" ANNOTATION_REF="a8319">
                <ANNOTATION_VALUE>"It's okay,</ANNOTATION_VALUE>
