    <TIER ANNOTATOR="Stefan Schnell" LINGUISTIC_TYPE_REF="symbolic_association" PARENT_REF="utterance" PARTICIPANT="VR10" TIER_ID="utterance_translation">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a12427" ANNOTATION_REF="a9275">
                <ANNOTATION_VALUE>One day there was a married couple.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a12428" ANNOTATION_REF="a9276">
                <ANNOTATION_VALUE>And as they lived on and on,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a12429" ANNOTATION_REF="a9277">
                <ANNOTATION_VALUE>the woman became pregnant and gave birth to a girl.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a12430" ANNOTATION_REF="a9278">
                <ANNOTATION_VALUE>Okay, then they looked after the child,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a12431" ANNOTATION_REF="a9279">
                <ANNOTATION_VALUE>and the child lived on and on and grew up.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a12432" ANNOTATION_REF="a9280">
                <ANNOTATION_VALUE>The woman got pregnant again</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a12433" ANNOTATION_REF="a9281">
                <ANNOTATION_VALUE>and gave birth to a girl again.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a12434" ANNOTATION_REF="a9282">
                <ANNOTATION_VALUE>And so they cared for them now,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
