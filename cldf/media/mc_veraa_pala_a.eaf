        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a11218" ANNOTATION_REF="a8338">
                <ANNOTATION_VALUE>they had already left the prayer.</ANNOTATION_VALUE>
