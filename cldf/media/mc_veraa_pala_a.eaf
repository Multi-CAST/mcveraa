        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a11216" ANNOTATION_REF="a8336">
                <ANNOTATION_VALUE>They went on and on,</ANNOTATION_VALUE>
