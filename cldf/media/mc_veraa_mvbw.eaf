        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a17070" ANNOTATION_REF="a49">
                <ANNOTATION_VALUE>duruk van din̄ man 'uvu wōqe 'enge ne vōwal lēn wōm̄ōm̄ō' dir ga ul son ... 'uvu wōqe 'enge 'anē n wēwē 'a bēne ga marmar nē</ANNOTATION_VALUE>
